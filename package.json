{
  "name": "kanu-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:windows": "npm ci --omit=optional --ignore-scripts && npm install --no-save --omit=optional --ignore-scripts @next/swc-win32-x64-msvc@16.3.8 @esbuild/win32-x64@0.28.2 @rollup/rollup-win32-x64-msvc@4.64.0",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "mysql2": "3.24.5",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "7.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/nodemailer": "7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
